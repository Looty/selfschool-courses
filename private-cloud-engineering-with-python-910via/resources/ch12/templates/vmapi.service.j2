# {{ ansible_managed }}
# Rendered for {{ inventory_hostname }} by the template task in site.yml.

[Unit]
Description=VM provisioning API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ vmapi_user }}
WorkingDirectory={{ vmapi_home }}
Environment=VMAPI_STATE_DIR=/var/lib/vmapi
Environment=VMAPI_LOG_DIR=/var/log/vmapi
ExecStart={{ vmapi_home }}/venv/bin/gunicorn --bind 127.0.0.1:{{ vmapi_port }} --workers {{ vmapi_workers }} vmapi.wsgi:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
